# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables (Production), then redeploy.

# ───────────── Website address (set after adding your domain) ─────────────
# Used for share links, emails, sitemap and Google. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://yourdomain.in"

# ───────────── MongoDB (required) ─────────────
# MongoDB Atlas → Connect → Drivers → copy the connection string.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mamonibhandar?retryWrites=true&w=majority"
# Optional: database name (overrides the one in the URI)
MONGODB_DB="mamonibhandar"

# ───────────── Owner / admin login (required) ─────────────
# Log in at /login with ADMIN_EMAIL + ADMIN_PASSWORD to open the admin panel.
ADMIN_EMAIL="maamonibhandar@gmail.com"
ADMIN_PASSWORD="choose-a-strong-password-10-plus-characters"

# ───────────── Login security key (required for production) ─────────────
# Random 64-character string. Generate one with:  openssl rand -hex 32
# Changing it logs everyone out once.
AUTH_SECRET=""

# ───────────── Cloudinary (required for product / banner photos) ─────────────
# Cloudinary Console → Dashboard → API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: upload folder
CLOUDINARY_FOLDER="mamonibhandar/products"

# ───────────── Email notifications (optional) ─────────────
# New-order alerts to the store + confirmations / status updates to customers.
# For Gmail: Google Account → Security → 2-Step Verification → App passwords.
SMTP_USER=""          # e.g. maamonibhandar@gmail.com
SMTP_PASS=""          # 16-character app password
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# ORDER_NOTIFY_EMAIL="maamonibhandar@gmail.com"
