# ───────────── MongoDB (required) ─────────────
# MongoDB Atlas → Connect → Drivers → copy the connection string.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mamonibhandar?retryWrites=true&w=majority"
# Optional: database name (overrides the one in the URI)
MONGODB_DB="mamonibhandar"

# ───────────── Cloudinary (required for product photos) ─────────────
# Cloudinary Console → Dashboard → API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# (Alternatively set CLOUDINARY_URL="cloudinary://<key>:<secret>@<cloud_name>" instead of the three above.)
# Optional: folder where product images are stored
CLOUDINARY_FOLDER="mamonibhandar/products"

# ───────────── Admin (required in production) ─────────────
ADMIN_PASSWORD="choose-a-strong-password"
# Optional: separate secret for signing admin session cookies (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=""
